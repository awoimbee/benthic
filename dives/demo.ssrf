<divelog program='subsurface' version='2'>
<settings>
<divecomputerid model='Shearwater Perdix' deviceid='1a2b3c4d' serial='12345678' firmware='93'/>
<divecomputerid model='Shearwater Perdix 2' deviceid='2b3c4d5e' serial='87654321' firmware='95'/>
  <autogroup state='1' />
</settings>
<divesites>
<site uuid='00000001' name='Le Grec' gps='43.015000 6.280000' description='Cargo wreck off Cap des Mèdes, 38 m'>
  <notes>Small cargo wreck on the sand at the foot of the wall. Mostly intact holds.</notes>
  <geo cat='1' origin='0' value='Mediterranean Sea'/>
  <geo cat='2' origin='0' value='France'/>
</site>
<site uuid='00000002' name='Le Donator' gps='42.970000 6.220000' description='Cargo wreck south of Porquerolles, 48 m'>
  <notes>The classic Var deep wreck: propeller, winches and two big holds.</notes>
  <geo cat='1' origin='0' value='Mediterranean Sea'/>
  <geo cat='2' origin='0' value='France'/>
</site>
<site uuid='00000003' name='Le Rubis' gps='43.135000 6.540000' description='Submarine wreck off Cavalaire, 41 m'>
  <notes>Sank in 1958 as a target. Conning tower at about 38 m, deck at 41 m.</notes>
  <geo cat='1' origin='0' value='Mediterranean Sea'/>
  <geo cat='2' origin='0' value='France'/>
</site>
<site uuid='00000004' name='Le Liban' gps='43.120000 6.560000' description='Freighter wreck off Cavalaire, 45 m'>
  <notes>Big freighter, broken in two. The bow section stands almost upright.</notes>
  <geo cat='1' origin='0' value='Mediterranean Sea'/>
  <geo cat='2' origin='0' value='France'/>
</site>
<site uuid='00000005' name='U-171' gps='47.610000 -3.480000' description='German U-boat off Groix, 42 m'>
  <notes>Type IXC boat, sunk in 1942. Cold, dark water and a lot of current.</notes>
  <geo cat='1' origin='0' value='Atlantic Ocean'/>
  <geo cat='2' origin='0' value='France'/>
</site>
<site uuid='00000006' name='Le Cyrano' gps='47.630000 -3.460000' description='Cargo wreck off Groix, 33 m'>
  <notes>Steamer on the sand, largely broken up. Lifeboat davits still visible.</notes>
  <geo cat='1' origin='0' value='Atlantic Ocean'/>
  <geo cat='2' origin='0' value='France'/>
</site>
<site uuid='00000007' name='La Horaine' gps='47.675000 -3.420000' description='Rocky plateau north of Groix, 18 m'>
  <notes>Kelp, spider crabs and a lot of life in the gullies. Sheltered from the swell.</notes>
  <geo cat='1' origin='0' value='Atlantic Ocean'/>
  <geo cat='2' origin='0' value='France'/>
</site>
<site uuid='00000008' name='La Gabinière' gps='42.992000 6.395000' description='Reef and drop-off at Port-Cros, 35 m'>
  <notes>Gorgonians, barracuda and groupers on the drop-off. Can get crowded in summer.</notes>
  <geo cat='1' origin='0' value='Mediterranean Sea'/>
  <geo cat='2' origin='0' value='France'/>
</site>
<site uuid='00000009' name='Lac d&#39;Annecy' gps='45.860000 6.175000' description='Freshwater lake, 447 m altitude'>
  <notes>Cold, clear freshwater. A small barge lies at about 15 m near the shore.</notes>
  <geo cat='2' origin='0' value='France'/>
</site>
<site uuid='0000000a' name='Les Lavezzi' gps='41.340000 9.260000' description='Granite islands south of Corsica, 18 m'>
  <notes>Boulders, posidonia meadows and tame groupers in the marine reserve.</notes>
  <geo cat='1' origin='0' value='Mediterranean Sea'/>
  <geo cat='2' origin='0' value='France'/>
</site>
<site uuid='0000000b' name='Baie de Villefranche' gps='43.696000 7.317000' description='Deep bay east of Nice, 30 m'>
  <notes>Steep wall dropping into blue water. A classic spot for line diving and training.</notes>
  <geo cat='1' origin='0' value='Mediterranean Sea'/>
  <geo cat='2' origin='0' value='France'/>
</site>
</divesites>
<dives>
<trip date='2024-05-12' time='08:30:00' location='Porquerolles'>
<dive number='1' tags='wreck, technical, deco' divesiteid='00000001' date='2024-05-12' time='09:00:00' duration='48:00 min' rating='4'>
  <divemaster>Yann</divemaster>
  <buddy>Camille</buddy>
  <notes>First dive on Le Grec. Air on the back, Nx70 for the hang from 6 m.
Dropped down the line, a quick lap of the holds and back up on the line.
Water was 17 C with a mild thermocline below 25 m.</notes>
  <suit>7mm wetsuit</suit>
  <cylinder size='15.0 l' workpressure='232.0 bar' description='steel 15' start='220.0 bar' end='80.0 bar' />
  <cylinder size='11.1 l' workpressure='207.0 bar' description='AL80 Nx70' o2='70.0%' start='200.0 bar' end='120.0 bar' />
  <weightsystem weight='5.0 kg' description='belt' />
  <divetemperature air='24.0 C' water='17.0 C' />
  <divecomputer model='Shearwater Perdix' deviceid='1a2b3c4d' diveid='00000001' duration='48:00 min'>
  <depth max='38.4 m' mean='24.8 m' />
